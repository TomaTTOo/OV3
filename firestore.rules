rules_version = '2';

// The website's Firestore: anyone may leave a contact message with the right fields and sizes; nobody may read,
// change or delete one from outside (the owner reads them in the Firebase console). Everything else is closed.
// The limits match apps/site/src/contact/message.ts (a test checks them against these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /contactMessages/{id} {
      allow create: if isContactMessage(request.resource.data);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isContactMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'company', 'message', 'createdAt'])
        && text(data.name, 1, 120)
        && text(data.email, 3, 200) && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && (!('company' in data) || text(data.company, 1, 120))
        && text(data.message, 1, 4000)
        && data.createdAt == request.time;
    }

    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
  }
}
