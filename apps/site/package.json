{
  "name": "@ov/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/stills.ts && node scripts/brand.ts && vite",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/stills.ts && node scripts/brand.ts && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.ts",
    "preview": "pnpm build && vite preview --outDir dist",
    "stills": "node scripts/stills.ts",
    "brand": "node scripts/brand.ts"
  },
  "dependencies": {
    "@fontsource/sora": "^5.3.0",
    "@ov/design": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
