{
  "name": "outcome-vault",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && stylelint \"apps/**/*.css\" \"packages/**/*.css\"",
    "format": "prettier --check .",
    "dupes": "jscpd apps/site/src apps/site/scripts apps/brand/src packages/design/src packages/design/scripts --min-lines 6 --exit-code 1",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm dupes && pnpm test",
    "build": "pnpm check && pnpm -r build",
    "deploy:site": "pnpm build && firebase deploy --only hosting --project default"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "15.33.0",
    "jscpd": "^5.4.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
